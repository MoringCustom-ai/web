# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token

# Количество дней челленджа (по умолчанию 14 — как в дизайн-макете)
CHALLENGE_DAYS=14

# Путь к SQLite базе
DB_PATH=club.db

# Ссылка на мини-приложение (https), если хостите webapp/ отдельно
MINI_APP_URL=
# Ссылка на закрытый чат клуба (t.me/...)
CHAT_BUTTON_URL=

# Время ежедневного напоминания (часы:минуты в таймзоне TIMEZONE)
REMINDER_HOUR=20
REMINDER_MINUTE=0
TIMEZONE=Europe/Moscow

# Для продакшена: webhook вместо long polling
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8443
# WEBHOOK_SECRET=random-secret

# Порт сервера мини-приложения (python -m webapp.server)
WEBAPP_PORT=3000
